# --- WAHA (WhatsApp HTTP API — self-hosted, NOT Meta Cloud API) ---
# Run WAHA with Docker (see docs/GO_LIVE_WAHA.md), then point these at your instance.
WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=sokoni-local-dev-key
WAHA_SESSION=default
# Shared secret — bot verifies X-Webhook-Hmac (sha512). Also used by scripts/configure-waha-session.sh.
# Generate: openssl rand -hex 32
WEBHOOK_HMAC_KEY=

# --- Rate limits (requests per IP per minute; optional overrides) ---
# RATE_LIMIT_API_MAX=60
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_ADMIN_MAX=30
# RATE_LIMIT_WEBHOOK_MAX=300

# --- AI via OpenRouter (OpenAI-compatible) ---
OPENAI_API_KEY=your_openrouter_api_key
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# WhatsApp bot + web chat (TEXT ONLY — free models, do not change for photos)
OPENAI_MODEL=openrouter/free
OPENAI_MODEL_FALLBACKS=google/gemma-4-26b-a4b-it:free

# Seller listing PHOTOS ONLY (sell page image → draft).
# Primary: multimodal vision/chat. Two OpenRouter fallbacks (krea kept — skipped for photo→JSON).
CATALOG_VISION_MODEL=google/gemini-2.5-flash
CATALOG_VISION_FALLBACKS=google/gemini-2.0-flash-001,krea/krea-2-medium-turbo

# Listing photo AI order: OpenRouter (CATALOG_VISION_*) → NVIDIA NIM → Gemini → caption stub
# NVIDIA NIM (build.nvidia.com) — free VLMs when OpenRouter is out of tokens
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional comma list; empty = curated free VLMs + /models vision filter
# NVIDIA_VISION_MODELS=meta/llama-3.2-11b-vision-instruct,microsoft/phi-3.5-vision-instruct
# NVIDIA_VISION_MAX_ATTEMPTS=4

# Gemini direct API — third fallback for listing drafts
GEMINI_API_KEY=AQ.Ab8RN6JKsaorEvw8bvKc277LHDh3lL3HMWNbPhrz_LJxDKkhKQ
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_VISION_MODELS=gemini-2.5-flash,gemini-2.0-flash-lite,gemini-2.0-flash
# --- Listing photo studio (cloud cleanup + optional clips — 0 MB on the bot VM) ---
# STUDIO_PROVIDER=auto|cloudinary|huggingface|photoroom|remote|off
# auto (default) tries configured providers free-first: cloudinary → huggingface → photoroom → remote
STUDIO_PROVIDER=auto
# Optional pin fallback when primary fails (e.g. STUDIO_PROVIDER=cloudinary + STUDIO_FALLBACK=huggingface)
# STUDIO_FALLBACK=
# Cloudinary product clips from the *cleaned* cutout (pad + shadow + zoompan MP4).
STUDIO_CLIP_ENABLED=true
# STUDIO_CLIP_INLINE=true     # heavy — embed data:video in API JSON (default off)
# STUDIO_INLINE_IMAGES=true   # heavy — embed cleaned PNG base64 (default off; use cleanImageUrl)

# Cloudinary — clean PNG, then clip from that cutout (Photoroom-style)
# https://cloudinary.com/documentation/background_removal
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=sokoni-studio
# CLOUDINARY_BG_EFFECT=e_background_removal
# Motion segment only — bot prefixes e_background_removal when clipping from an original upload:
# CLOUDINARY_CLIP_TRANS=c_pad,w_1080,h_1080,b_rgb:FFF8F0/e_shadow:45/e_zoompan:du_4;fps_30;mode_ofl;maxzoom_1.4/w_720,q_auto:eco,vc_h264
# Temp listing_* only — cutout_/reel_ CDN assets are never auto-deleted:
# CLOUDINARY_DELETE_AFTER=true
# CLOUDINARY_DELETE_MS=180000
# Multi-photo showcase reel on publish (Cloudinary multi API):
# CLOUDINARY_REEL_DELAY_MS=2000
# CLOUDINARY_REEL_TRANS=dl_2000/w_720,h_720,c_pad,b_rgb:FFF8F0/q_auto:eco,vc_h264

# Hugging Face — remote inference (many Hub RMBG models need a dedicated endpoint / Space URL)
# https://huggingface.co/docs/api-inference
HUGGINGFACE_API_KEY=
# HUGGINGFACE_RMBG_MODEL=briaai/RMBG-1.4
# Or full override (Inference Endpoint / working proxy):
# HUGGINGFACE_RMBG_URL=https://router.huggingface.co/hf-inference/models/briaai/RMBG-1.4

# Photoroom Segment API (paid quality option)
# https://www.photoroom.com/api
PHOTOROOM_API_KEY=

# Optional external rembg microservice (Modal/Render) — POST image bytes → PNG
# STUDIO_REMOTE_URL=
# STUDIO_REMOTE_KEY=


CATALOG_AUTO_PUSH=true
# Git identity for catalog commits from the VM (required for auto-push)
GIT_AUTHOR_NAME=sokoni-bot
GIT_AUTHOR_EMAIL=bot@sokonimall.com
# Wait before rebuild after seller listing approval (milliseconds)
CATALOG_PUBLISH_DEBOUNCE_MS=30000

# --- App ---
PORT=3001
PUBLIC_SITE_URL=https://sokonimall.com
# Bot HTTPS URL — WhatsApp product images (served from /catalog-images on the VM)
BOT_PUBLIC_URL=https://bot.sokonimall.com

# --- PostgreSQL (Phase 1 — optional; bot falls back to products.json if unset) ---
# Local dev: docker compose -f docker-compose.db.yml up -d
# DATABASE_URL=postgresql://sokoni:sokoni@localhost:5432/sokoni
DATABASE_URL=
DATABASE_POOL_MAX=10

# --- Affiliate sub-IDs (optional — international affiliate items only) ---
KILIMALL_AFFILIATE_ID=your_kilimall_affiliate_id
JUMIA_AFFILIATE_ID=your_jumia_kol_affiliate_id
ALIEXPRESS_AFFILIATE_ID=your_aliexpress_affiliate_id
TEMU_AFFILIATE_ID=your_temu_affiliate_id
AMAZON_AFFILIATE_TAG=your_amazon_associates_tag

# --- Store / prepaid escrow (Phase 5) ---
PREPAID_ONLY=true
STORE_MARKUP_KES=100
STORE_COD_AREAS=Kenya countrywide
STORE_DELIVERY_NOTE=Delivery in 1-3 days within Nairobi; countrywide via courier. 100% prepaid upfront — escrow until delivery confirmed.
# Display / PartyB shortcode (SOKONIMA production). Legacy personal till 4775847 retired.
MPESA_TILL_NUMBER=3439153
MPESA_TILL_NAME=SOKONIMA
# Safaricom Daraja — Prod-SOKONIMALL (Buy Goods Till 3439153 / SOKONIMA)
# deploy-bot.sh runs scripts/set-daraja-env.sh to write live Consumer Key/Secret/Passkey.
# Org products/roles: Lipa Na M-Pesa Online (STK), C2B, B2C API Initiator, Balance Query,
# Transaction Status, Org Reversals, Business Paybill / Buy Goods Org API.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
# BusinessShortCode used in STK password — Daraja "Short Code" (3439153)
MPESA_SHORTCODE=3439153
# Optional override for PartyB (defaults to MPESA_TILL_NUMBER, then SHORTCODE)
# MPESA_PARTY_B=
MPESA_ENV=production
# Paybill → CustomerBuyGoodsOnline | Till/Buy Goods → CustomerBuyGoodsOnline
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
# Prefer /daraja/callback (Safaricom often rejects URLs containing "mpesa")
MPESA_CALLBACK_URL=https://bot.sokonimall.com/api/payments/daraja/callback
# --- B2C seller payouts (role: B2C API Initiator/Caller + Business Paybill Org API) ---
# Initiator username from M-Pesa org portal — required for #payb2c (not needed for buyer STK)
MPESA_INITIATOR_NAME=
# Pre-encrypted SecurityCredential from Daraja portal (preferred)
MPESA_SECURITY_CREDENTIAL=
# OR encrypt at runtime: plain password + path to ProductionCertificate.cer / SandboxCertificate.cer
# MPESA_INITIATOR_PASSWORD=
# MPESA_CERT_PATH=/home/ubuntu/sokoni/whatsapp-bot/certs/ProductionCertificate.cer
MPESA_B2C_SHORTCODE=3439153
MPESA_B2C_COMMAND_ID=BusinessPayment
MPESA_B2C_RESULT_URL=https://bot.sokonimall.com/api/payments/daraja/b2c/result
MPESA_B2C_TIMEOUT_URL=https://bot.sokonimall.com/api/payments/daraja/b2c/timeout
# When true, owed settlements auto-send via B2C after escrow hold (leave false until first manual #payb2c works)
MPESA_B2C_AUTO=false
BUSINESS_WHATSAPP_NUMBER=254117422428
BUSINESS_PHONE_DISPLAY=+254 117 422 428
SUPPORT_EMAIL=support@sokonimall.com
BUSINESS_LOCATION=Sokoni Mall Startup Hub, Nairobi, Kenya
MAX_OFFER_PERCENT=3
PROMO_CODE=SOKONI3
HUMAN_SUPPORT_START=07:30
HUMAN_SUPPORT_END=21:00
BUSINESS_TIMEZONE=Africa/Nairobi

# --- Ops (optional extra webhook for orders/handoffs) ---
ADMIN_NOTIFY_URL=
# Token for /admin/ops/* REST API (falls back to SUPPLIER_ADMIN_TOKEN or TIKTOK_SETUP_TOKEN)
ADMIN_SETUP_TOKEN=
# Admin console phone(s), comma-separated. Use a DIFFERENT number from the bot:
# order/handoff alerts go here, and messages from here are treated as admin
# commands (#orders, #status, #broadcast, # reply). Only these numbers get admin access.
ADMIN_PHONES=254757764009

# --- TikTok auto-posting (backend only — not shown on website) ---
# Get credentials from developers.tiktok.com (Content Posting API + Login Kit).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3001/admin/tiktok/callback
TIKTOK_SCOPES=user.info.basic,video.publish
# One-time setup secret for /admin/tiktok/connect (any long random string)
TIKTOK_SETUP_TOKEN=
# URL-prefix verification line from TikTok portal (tiktok....txt file contents)
TIKTOK_VERIFY_SIGNATURE=
# Optional bootstrap only — after OAuth, tokens live in data/tiktok-oauth.json
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_CRON_ENABLED=false
# Post times in EAT (Africa/Nairobi): 8:00 AM, 1:00 PM, 7:30 PM
TIKTOK_POST_TIMES=08:00,13:00,19:30
TIKTOK_TIMEZONE=Africa/Nairobi
# SELF_ONLY until app audit; then PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
