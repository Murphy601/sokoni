# --- WAHA (WhatsApp HTTP API — self-hosted, NOT Meta Cloud API) ---
# Run WAHA with Docker (see docs/GO_LIVE_WAHA.md), then point these at your instance.
WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=sokoni-local-dev-key
WAHA_SESSION=default
# Shared secret — bot verifies X-Webhook-Hmac (sha512). Also used by scripts/configure-waha-session.sh.
# Generate: openssl rand -hex 32
WEBHOOK_HMAC_KEY=

# --- Rate limits (requests per IP per minute; optional overrides) ---
# RATE_LIMIT_API_MAX=60
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_ADMIN_MAX=30
# RATE_LIMIT_WEBHOOK_MAX=300

# --- AI chat (WhatsApp + web) — Groq first, OpenRouter free fallback ---
# Provider order when AI_CHAT_PROVIDER=auto: Groq → OpenRouter
# Gemini chat is OFF unless AI_CHAT_PROVIDER=gemini or AI_CHAT_USE_GEMINI=true
# (GEMINI_API_KEY alone is for listing vision — keep it out of the chat chain)
AI_CHAT_PROVIDER=auto
AI_CHAT_TEMPERATURE=0.15
# AI_CHAT_USE_GEMINI=false

# Groq Cloud — set on the bot VM via scripts/set-groq-env.sh (never commit)
# Default openai/gpt-oss-20b (llama-3.1-8b-instant retired Aug 2026)
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_MODEL_FALLBACKS=openai/gpt-oss-120b

# OpenRouter (already on VM) — free fallback when Groq is unset/unavailable
# Prefer a named free model; openrouter/free auto-router is slow / queue-prone for WhatsApp.
OPENAI_API_KEY=your_openrouter_api_key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemma-4-31b-it:free
# OPENAI_TRANSCRIBE_MODEL=openai/whisper-large-v3-turbo
# OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_MODEL_FALLBACKS=openrouter/free
# Soft output ceiling (clamped 200–800). Low values cause mid-sentence cuts.
# AI_CHAT_MAX_TOKENS=480

# Do NOT use local Ollama for production WhatsApp — it serialises requests under load.

# Seller listing PHOTOS ONLY (sell page image → draft). Prefer free OpenRouter VLMs.
# Code order: OpenRouter (these) → NVIDIA NIM free pool → optional Gemini → caption stub.
CATALOG_VISION_MODEL=openrouter/free
CATALOG_VISION_FALLBACKS=nvidia/nemotron-nano-12b-v2-vl:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Listing photo AI order: OpenRouter (CATALOG_VISION_*) → NVIDIA NIM → Gemini → caption stub
# NVIDIA NIM (build.nvidia.com) — free VLMs when OpenRouter is out of tokens
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional comma list; empty = curated free VLMs + /models vision filter
# NVIDIA_VISION_MODELS=meta/llama-3.2-11b-vision-instruct,microsoft/phi-3.5-vision-instruct
# NVIDIA_VISION_MAX_ATTEMPTS=4

# Buyer WhatsApp photo → stock match (FREE models only — ignores paid CATALOG_VISION_*)
# Order: OpenRouter free → NVIDIA free pool → optional Gemini
# IMAGE_SEARCH_VISION_MODELS=openrouter/free,nvidia/nemotron-nano-12b-v2-vl:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Set false if Gemini keys expire weekly and you want OpenRouter/NVIDIA only:
# IMAGE_SEARCH_ALLOW_GEMINI=false

# Gemini direct API — listing photo fallback; chat only if AI_CHAT_USE_GEMINI=true
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
# GEMINI_CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_VISION_MODELS=gemini-2.5-flash,gemini-2.0-flash-lite,gemini-2.0-flash
# --- Listing photo studio (cloud cleanup + optional clips — 0 MB on the bot VM) ---
# STUDIO_PROVIDER=auto|cloudinary|huggingface|photoroom|remote|off
# auto (default) tries configured providers free-first: cloudinary → huggingface → photoroom → remote
STUDIO_PROVIDER=auto
# Optional pin fallback when primary fails (e.g. STUDIO_PROVIDER=cloudinary + STUDIO_FALLBACK=huggingface)
# STUDIO_FALLBACK=
# Cloudinary product clips from the *cleaned* cutout (pad + shadow + zoompan MP4).
STUDIO_CLIP_ENABLED=true
# STUDIO_CLIP_INLINE=true     # heavy — embed data:video in API JSON (default off)
# STUDIO_INLINE_IMAGES=true   # heavy — embed cleaned PNG base64 (default off; use cleanImageUrl)

# Cloudinary — clean PNG, then clip from that cutout (Photoroom-style)
# https://cloudinary.com/documentation/background_removal
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=sokoni-studio
# CLOUDINARY_BG_EFFECT=e_background_removal
# Motion segment only — bot prefixes e_background_removal when clipping from an original upload:
# CLOUDINARY_CLIP_TRANS=c_pad,w_1080,h_1080,b_rgb:FFF8F0/e_shadow:45/e_zoompan:du_4;fps_30;mode_ofl;maxzoom_1.4/w_720,q_auto:eco,vc_h264
# Temp listing_* only — cutout_/reel_ CDN assets are never auto-deleted:
# CLOUDINARY_DELETE_AFTER=true
# CLOUDINARY_DELETE_MS=180000
# Multi-photo showcase reel on publish (Cloudinary multi API):
# CLOUDINARY_REEL_DELAY_MS=2000
# CLOUDINARY_REEL_TRANS=dl_2000/w_720,h_720,c_pad,b_rgb:FFF8F0/q_auto:eco,vc_h264

# Soft clip fallbacks — only after Cloudinary zoompan/multi fails (fail-soft; unset = off)
# STUDIO_CLIP_FALLBACKS=hyperframes,remotion
# HyperFrames (HeyGen cloud HTML→MP4): https://developers.heygen.com/hyperframes
# HEYGEN_API_KEY=
# HYPERFRAMES_API_KEY=          # alias for HEYGEN_API_KEY
# Optional pre-uploaded project zip (else bot builds a tiny Ken Burns index.html zip):
# HYPERFRAMES_PROJECT_ASSET_ID=
# HYPERFRAMES_PROJECT_URL=
# HYPERFRAMES_QUALITY=draft
# HYPERFRAMES_POLL_MS=3000
# HYPERFRAMES_TIMEOUT_MS=180000
# Remotion — Sokoni VM uses Method B (local remotion-worker on :3105 via PM2).
# deploy-bot.sh / configure-clip-fallbacks.sh set these automatically when HEYGEN_API_KEY is present:
# REMOTION_RENDER_URL=http://127.0.0.1:3105/render
# REMOTION_COMPOSITION=SokoniProduct
# REMOTION_WORKER_PORT=3105

# --- Multi-Agent System (MAS) fallback gateway — does NOT replace primaries ---
# Video clip order stays: Cloudinary Ken Burns → HeyGen HyperFrames → Remotion.
# MAS only shadows by default; live assists need explicit flags.
# MAS_ENABLED=true
# MAS_SHADOW=true
# MAS_TIMEOUT_MS=2000
# Phase 2 — only AFTER Cloudinary+HeyGen+Remotion fail:
# MAS_ENABLE_MEDIA_FALLBACK=false
# Phase 3 — STT/translate/chat assist when primary fails:
# MAS_ENABLE_VOICE_ASSIST=false
# MAS_ENABLE_CHAT_FAILOVER=false
# MAS_ENABLE_MODERATION_LIVE=false
# Phase 4 — shadow advisors for disputes/logistics (never auto-payout):
# MAS_ENABLE_TX_SHADOW=false
# Optional per-task route override: MAS_ROUTE_RECEIPT_OCR=nvidia:meta/llama-3.2-11b-vision-instruct,stub:ocr
# Optional Method A Lambda (instead of local worker):
# REMOTION_SERVE_URL=https://remotionlambda-….s3.…/sites/sokoni-mall-render/index.html
# REMOTION_FUNCTION_NAME=remotion-render-…
# REMOTION_REGION=us-east-1
# REMOTION_RENDER_KEY=
# REMOTION_LIGHT_MODE=false   # true = skip Chromium, Cloudinary-only inside worker

# Hugging Face — remote inference (many Hub RMBG models need a dedicated endpoint / Space URL)
# https://huggingface.co/docs/api-inference
HUGGINGFACE_API_KEY=
# HUGGINGFACE_RMBG_MODEL=briaai/RMBG-1.4
# Or full override (Inference Endpoint / working proxy):
# HUGGINGFACE_RMBG_URL=https://router.huggingface.co/hf-inference/models/briaai/RMBG-1.4

# Photoroom Segment API (paid quality option)
# https://www.photoroom.com/api
PHOTOROOM_API_KEY=

# Optional external rembg microservice (Modal/Render) — POST image bytes → PNG
# STUDIO_REMOTE_URL=
# STUDIO_REMOTE_KEY=


CATALOG_AUTO_PUSH=true
# Git identity for catalog commits from the VM (required for auto-push)
GIT_AUTHOR_NAME=sokoni-bot
GIT_AUTHOR_EMAIL=bot@sokonimall.com
# Wait before rebuild after seller listing approval (milliseconds)
CATALOG_PUBLISH_DEBOUNCE_MS=30000

# --- App ---
PORT=3001
PUBLIC_SITE_URL=https://sokonimall.com
# Bot HTTPS URL — WhatsApp product images (served from /catalog-images on the VM)
BOT_PUBLIC_URL=https://bot.sokonimall.com

# --- PostgreSQL (Phase 1 — optional; bot falls back to products.json if unset) ---
# Local dev: docker compose -f docker-compose.db.yml up -d
# DATABASE_URL=postgresql://sokoni:sokoni@localhost:5432/sokoni
DATABASE_URL=
DATABASE_POOL_MAX=10

# --- Affiliate sub-IDs (optional — international affiliate items only) ---
KILIMALL_AFFILIATE_ID=your_kilimall_affiliate_id
JUMIA_AFFILIATE_ID=your_jumia_kol_affiliate_id
ALIEXPRESS_AFFILIATE_ID=your_aliexpress_affiliate_id
TEMU_AFFILIATE_ID=your_temu_affiliate_id
AMAZON_AFFILIATE_TAG=your_amazon_associates_tag

# --- Store / prepaid escrow (Phase 5) ---
PREPAID_ONLY=true
STORE_MARKUP_KES=100
STORE_COD_AREAS=Kenya countrywide
STORE_DELIVERY_NOTE=Delivery in 1-3 days within Nairobi; countrywide via courier. 100% prepaid upfront — escrow until delivery confirmed.
# Buy Goods hierarchy (Sokoni):
#   MPESA_SHORTCODE   = 3439153  Daraja / org H.O. → STK BusinessShortCode + password
#   Merchant store    = 4421485  (portal only — not sent on STK)
#   MPESA_TILL_NUMBER = 4775847  Buy Goods till → STK PartyB
MPESA_TILL_NUMBER=4775847
MPESA_TILL_NAME="David Thuku Muiruri"
# Safaricom Daraja — Prod-SOKONIMALL (org shortcode 3439153)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=3439153
# MPESA_PARTY_B=4775847
MPESA_ENV=production
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
MPESA_CALLBACK_URL=https://bot.sokonimall.com/api/payments/daraja/callback
# --- B2C seller payouts (org Initiator — NOT used for buyer STK) ---
# Prod-SOKONIMALL go-live URLs include:
#   OAuth  https://api.safaricom.co.ke/oauth/v1/generate
#   B2C    https://api.safaricom.co.ke/mpesa/b2c/v1/paymentrequest
#   STK    https://api.safaricom.co.ke/mpesa/stkpush/v1/processrequest
# B2C initiator (org user for payouts) — not the STK app name. Same shortcode 3439153.
MPESA_INITIATOR_NAME=DavidMuiruri
# Prefer: bash scripts/configure-b2c-initiator.sh (encrypts password with ProductionCertificate.cer)
# SecurityCredential MUST be generated for DavidMuiruri (SOKONIMA credential will fail).
MPESA_SECURITY_CREDENTIAL=
# OR encrypt at runtime: plain password + path to ProductionCertificate.cer
# MPESA_INITIATOR_PASSWORD=
MPESA_CERT_PATH=/home/daviemuiruri3888/sokoni/whatsapp-bot/certs/ProductionCertificate.cer
MPESA_B2C_SHORTCODE=3439153
MPESA_B2C_COMMAND_ID=BusinessPayment
MPESA_B2C_RESULT_URL=https://bot.sokonimall.com/api/payments/daraja/b2c/result
MPESA_B2C_TIMEOUT_URL=https://bot.sokonimall.com/api/payments/daraja/b2c/timeout
# When true, owed settlements auto-send via B2C after escrow hold (leave false until first #payb2c / withdraw works)
MPESA_B2C_AUTO=false
# 0 = on delivery / buyer confirm, credit Seller Hub Ready for M-Pesa immediately
ESCROW_HOLD_BUSINESS_DAYS=0
# When true (default) and B2C initiator is configured, seller Withdraw triggers Daraja B2C immediately
SELLER_WITHDRAW_INSTANT_B2C=true
# --- Paystack (buyer C2B STK + seller M-Pesa payouts) ---
# Paystack Dashboard → Settings → API Keys & Webhooks (Live):
#   Callback  https://sokonimall.com/checkout.html
#   Webhook   https://bot.sokonimall.com/api/webhooks/paystack
# Optional IP whitelist (bot VM): 104.197.128.235
# Enable Mobile Money + Transfers. Fund the KES balance.
# Live Secret Key only — sk_live_…  (never pk_live_…, never a truncated sk_live_...)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# true (default) — never fall back to Daraja STK or B2C
PAYSTACK_ONLY=true
BUYER_PAY_RAIL=paystack
PAYSTACK_COLLECT=true
# PAYSTACK_CHARGE_EMAIL=orders@sokonimall.com
SELLER_PAYOUT_RAIL=paystack
# false = Starter Business workaround — skip Transfer API, queue admin #paid
# PAYSTACK_TRANSFERS=false
# SELLER_WITHDRAW_INSTANT_PAYSTACK=true
# PAYSTACK_WEBHOOK_URL=https://bot.sokonimall.com/api/webhooks/paystack
BUSINESS_WHATSAPP_NUMBER=254117422428
BUSINESS_PHONE_DISPLAY=+254 117 422 428
SUPPORT_EMAIL=support@sokonimall.com
BUSINESS_LOCATION=Sokoni Mall Startup Hub, Nairobi, Kenya
MAX_OFFER_PERCENT=3
PROMO_CODE=SOKONI3
HUMAN_SUPPORT_START=07:30
HUMAN_SUPPORT_END=21:00
BUSINESS_TIMEZONE=Africa/Nairobi

# --- Ops (optional extra webhook for orders/handoffs) ---
ADMIN_NOTIFY_URL=
# Token for /admin/ops/* REST API (falls back to SUPPLIER_ADMIN_TOKEN or TIKTOK_SETUP_TOKEN)
ADMIN_SETUP_TOKEN=
# Admin console phone(s), comma-separated. Use a DIFFERENT number from the bot:
# order/handoff alerts go here, and messages from here are treated as admin
# commands (#orders, #status, #broadcast, # reply). Only these numbers get admin access.
ADMIN_PHONES=254757764009
# Optional alias (also used for dispute alerts if ADMIN_PHONES empty):
# ADMIN_WHATSAPP_NUMBER=2547XXXXXXXX
# Honorific for Boss line AI tone + OVERRIDE: acks (default: first name of FOUNDER_NAME)
# ADMIN_BOSS_TITLE=Boss
# Master WhatsApp overrides (ADMIN_PHONES only — never for buyers/sellers/riders):
#   OVERRIDE: RELEASE SKN-####
#   OVERRIDE: UNBAN RIDER +2547…
#   OVERRIDE: SYSTEM PAUSE | OVERRIDE: SYSTEM RESUME
#   OVERRIDE: HELP

# --- TikTok auto-posting (backend only — not shown on website) ---
# Get credentials from developers.tiktok.com (Content Posting API + Login Kit).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3001/admin/tiktok/callback
TIKTOK_SCOPES=user.info.basic,video.publish
# One-time setup secret for /admin/tiktok/connect (any long random string)
TIKTOK_SETUP_TOKEN=
# URL-prefix verification line from TikTok portal (tiktok....txt file contents)
TIKTOK_VERIFY_SIGNATURE=
# Optional bootstrap only — after OAuth, tokens live in data/tiktok-oauth.json
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_CRON_ENABLED=false
# Post times in EAT (Africa/Nairobi): 8:00 AM, 1:00 PM, 7:30 PM
TIKTOK_POST_TIMES=08:00,13:00,19:30
TIKTOK_TIMEZONE=Africa/Nairobi
# SELF_ONLY until app audit; then PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
