{
  "name": "sokoni-whatsapp-bot",
  "version": "0.1.0",
  "description": "AI-powered WhatsApp shopping concierge — structured menus + free-text AI agent + tracked affiliate links.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint src",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node scripts/migrate-catalog-to-db.mjs",
    "db:backfill-browse": "node scripts/backfill-browse-categories.mjs"
  },
  "keywords": [
    "whatsapp",
    "affiliate",
    "ai",
    "shopping",
    "concierge"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.77.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0"
  },
  "engines": {
    "node": ">=18"
  }
}
