{
  "name": "sokoni-whatsapp-bot",
  "version": "0.1.0",
  "description": "AI-powered WhatsApp shopping concierge — structured menus + free-text AI agent + tracked affiliate links.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint src",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node scripts/migrate-catalog-to-db.mjs",
    "db:backfill-browse": "node scripts/backfill-browse-categories.mjs",
    "catalog:clear": "node scripts/clear-all-catalog.mjs",
    "test:listing": "node scripts/test-listing-generator.mjs",
    "test:listing-moderation": "node scripts/test-listing-moderation.mjs",
    "test:listing-studio": "node scripts/test-listing-studio.mjs",
    "test:clip-fallbacks": "node scripts/test-clip-fallbacks.mjs",
    "test:daraja-checkout": "node scripts/test-daraja-checkout.mjs",
    "test:paystack-payouts": "node scripts/test-paystack-payouts.mjs",
    "test:hybrid-shipping": "node scripts/test-hybrid-shipping.mjs",
    "test:gemini": "node scripts/test-gemini-vision.mjs",
    "test:nvidia": "node scripts/test-nvidia-vision.mjs",
    "verify:cloudinary": "node scripts/verify-cloudinary.mjs",
    "test:account-auth": "node scripts/test-account-auth.mjs",
    "test:buyer-auth": "node scripts/test-buyer-social-auth.mjs",
    "test:social-routing": "node scripts/test-social-auth-routing.mjs",
    "test:seller-social-profile": "node scripts/test-seller-social-profile.mjs",
    "test:agent-router": "node scripts/test-agent-tool-router.mjs",
    "test:bulk-csv": "node scripts/test-bulk-listing-csv.mjs",
    "test:social": "npm run test:buyer-auth && npm run test:social-routing && npm run test:seller-social-profile"
  },
  "keywords": [
    "whatsapp",
    "affiliate",
    "ai",
    "shopping",
    "concierge"
  ],
  "license": "MIT",
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "eslint": "^9.17.0"
  },
  "engines": {
    "node": ">=18"
  }
}
